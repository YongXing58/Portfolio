---
import type { ProjectEntry } from '@data/resume';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
---

<article class="panel reveal group p-6 transition-colors hover:border-accent-teal/50 sm:p-8">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-lg font-semibold text-paper-100 sm:text-xl">{project.title}</h3>
    <span class="font-mono text-xs text-paper-400">{project.date}</span>
  </div>

  {project.role ? <p class="mt-1 font-mono text-xs text-accent-teal/80">{project.role}</p> : null}

  <p class="mt-2 text-sm text-paper-400 sm:text-base">{project.summary}</p>

  {project.description ? <p class="mt-3 text-sm leading-relaxed text-paper-400/90">{project.description}</p> : null}

  {
    project.tags?.length ? (
      <div class="mt-5 flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    ) : null
  }

  {
    project.links?.demo || project.links?.repo || project.links?.caseStudy ? (
      <div class="mt-5 flex flex-wrap gap-4 font-mono text-xs">
        {project.links?.demo ? (
          <a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="link-underline">
            Live ↗
          </a>
        ) : null}
        {project.links?.repo ? (
          <a href={project.links.repo} target="_blank" rel="noopener noreferrer" class="link-underline">
            Code ↗
          </a>
        ) : null}
        {project.links?.caseStudy ? (
          <a href={project.links.caseStudy} target="_blank" rel="noopener noreferrer" class="link-underline">
            Case Study ↗
          </a>
        ) : null}
      </div>
    ) : null
  }
</article>
