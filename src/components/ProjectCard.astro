---
import type { ProjectEntry } from '@data/resume';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
---

<article class="panel reveal p-6 sm:p-8">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-xl text-ink-900 sm:text-2xl">{project.title}</h3>
    <span class="rounded-full border-2 border-ink-900 bg-paper-50 px-3 py-1 font-mono text-xs font-bold text-ink-700">
      {project.date}
    </span>
  </div>

  {project.role ? <p class="mt-1 font-hand text-lg font-bold text-splash-red">{project.role}</p> : null}

  <p class="mt-3 text-sm text-ink-700 sm:text-base">{project.summary}</p>

  {project.description ? <p class="mt-3 text-sm leading-relaxed text-ink-700/90">{project.description}</p> : null}

  {
    project.tags?.length ? (
      <div class="mt-5 flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    ) : null
  }

  {
    project.links?.demo || project.links?.repo || project.links?.caseStudy ? (
      <div class="mt-5 flex flex-wrap gap-4 font-mono text-xs">
        {project.links?.demo ? (
          <a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="link-underline">
            Live ↗
          </a>
        ) : null}
        {project.links?.repo ? (
          <a href={project.links.repo} target="_blank" rel="noopener noreferrer" class="link-underline">
            Code ↗
          </a>
        ) : null}
        {project.links?.caseStudy ? (
          <a href={project.links.caseStudy} target="_blank" rel="noopener noreferrer" class="link-underline">
            Case Study ↗
          </a>
        ) : null}
      </div>
    ) : null
  }
</article>
