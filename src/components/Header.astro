---
import { resume } from '@data/resume';

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Experience', href: '#experience' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];

// One progress dot per top-level section the page actually renders —
// Certifications self-omits when there are none, so skip its dot too.
const progressSections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills & Education' },
  ...(resume.certifications.length ? [{ id: 'certifications', label: 'Licenses & Certifications' }] : []),
  { id: 'projects', label: 'Projects' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b-[3px] border-ink-900 bg-paper-50/95 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
    <a href="#top" class="font-display text-xl text-ink-900 -rotate-2 transition-transform hover:rotate-0">
      {resume.profile.name}
    </a>
    <nav class="hidden gap-2 font-hand text-lg font-bold text-ink-900 sm:flex">
      {
        navItems.map((item, i) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full border-2 border-ink-900 px-4 py-1 shadow-comic-sm transition-all hover:-translate-y-0.5 hover:shadow-comic',
              i % 3 === 0 ? 'bg-splash-yellow/60' : i % 3 === 1 ? 'bg-splash-blue/20' : 'bg-splash-red/15',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Scroll progress: one dot per section, filled in as you reach it
         (see the IntersectionObserver in BaseLayout.astro). Large screens
         only — the header is already busy enough on mobile/tablet. -->
    <nav aria-label="Section progress" class="hidden items-center gap-1.5 lg:flex">
      {
        progressSections.map((s) => (
          <a href={`#${s.id}`} class="progress-dot" data-target={s.id}>
            <span class="sr-only">Jump to {s.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href={resume.profile.resumePdf} class="comic-btn hidden sm:inline-flex" download>
        Resume ↓
      </a>
      <button
        type="button"
        id="mobile-nav-toggle"
        class="comic-btn grid h-10 w-10 place-items-center p-0 sm:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
      >
        <span class="sr-only">Toggle navigation menu</span>
        <svg id="mobile-nav-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="mobile-nav-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden flex-col gap-2 border-t-[3px] border-ink-900 bg-paper-100 px-6 py-4 font-hand text-lg font-bold text-ink-900 sm:hidden"
  >
    {
      navItems.map((item) => (
        <a href={item.href} class="rounded-xl border-2 border-ink-900 bg-paper-50 px-4 py-3 shadow-comic-sm transition-transform active:translate-x-0.5 active:translate-y-0.5 active:shadow-none">
          {item.label}
        </a>
      ))
    }
    <a href={resume.profile.resumePdf} class="comic-btn justify-center font-mono text-sm normal-case" download>
      Download Resume ↓
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('mobile-nav-icon-open');
  const iconClose = document.getElementById('mobile-nav-icon-close');

  if (toggle && menu && iconOpen && iconClose) {
    const closeMenu = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });

    // Close the menu once a link is tapped, so it doesn't stay open after navigating.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  }
</script>
