---
import { resume } from '@data/resume';

const year = new Date().getFullYear();
const { links, email } = resume.profile;
---

<footer id="contact" class="snap-section section-enter relative mx-auto max-w-5xl px-6 py-16" data-anim="rise">
  <div class="bg-blob bg-blob-yellow -right-40 bottom-0 h-80 w-80 sm:h-[26rem] sm:w-[26rem]" aria-hidden="true"></div>

  <!-- Hand-drawn waving stickman — the closing "character" of the page. -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute -left-4 top-24 hidden h-24 w-20 text-ink-900 animate-float sm:-left-6 sm:top-28 sm:block"
    viewBox="0 0 80 100"
    fill="none"
  >
    <circle cx="40" cy="18" r="12" stroke="currentColor" stroke-width="4" />
    <circle cx="36" cy="16" r="1.5" fill="currentColor" />
    <circle cx="44" cy="16" r="1.5" fill="currentColor" />
    <path d="M36 22 Q40 25 44 22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
    <path d="M40 30 L40 62" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <path d="M40 38 L18 22" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <path d="M40 38 L60 50" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <path d="M40 62 L24 92" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <path d="M40 62 L56 92" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
  </svg>

  <span class="narration-caption reveal">To be continued...</span>
  <div class="reveal mb-6 flex flex-wrap items-center gap-3">
    <p class="section-label">Contact</p>
    <span class="chapter-badge">CH. 06 / 06</span>
  </div>

  <div class="panel panel-tape reveal flex flex-col items-start gap-6 p-8 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 class="text-2xl text-ink-900 sm:text-3xl">Let's talk.</h3>
      <a href={`mailto:${email}`} class="link-underline mt-2 inline-block text-base sm:text-lg">
        {email}
      </a>
    </div>
    <div class="flex gap-3">
      {links.linkedin && <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="comic-btn">LinkedIn</a>}
      {links.github && <a href={links.github} target="_blank" rel="noopener noreferrer" class="comic-btn">GitHub</a>}
    </div>
  </div>

  <p class="mt-8 text-center font-hand text-lg font-bold text-ink-400">
    © {year} {resume.profile.name} — built with Astro + Tailwind, a lot of coffee, and a little chaos.
  </p>
</footer>
