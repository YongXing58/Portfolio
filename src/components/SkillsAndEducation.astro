---
import { resume } from '@data/resume';
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-20">
  <div class="grid gap-12 sm:grid-cols-2">
    <div>
      <p class="section-label mb-8">Skills</p>
      <div class="space-y-6">
        {
          resume.skills.map((group) => (
            <div>
              <h4 class="mb-2 text-sm font-medium text-paper-100">{group.category}</h4>
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="tag-pill">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div>
      <p class="section-label mb-8">Education</p>
      <div class="space-y-6">
        {
          resume.education.map((edu) => (
            <div class="panel p-5">
              <h4 class="text-sm font-semibold text-paper-100 sm:text-base">{edu.institution}</h4>
              <p class="mt-1 text-sm text-paper-400">{edu.degree}</p>
              <p class="mt-1 font-mono text-xs text-paper-400">
                {edu.startDate} — {edu.endDate} · {edu.location}
              </p>
              {edu.highlights?.length ? (
                <ul class="mt-3 space-y-1 text-sm text-paper-400">
                  {edu.highlights.map((h) => (
                    <li>· {h}</li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
