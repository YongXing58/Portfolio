---
import { resume } from '@data/resume';
---

<section id="skills" class="snap-section section-enter relative mx-auto max-w-5xl px-6 py-16" data-anim="slide-right">
  <div class="bg-blob bg-blob-yellow -left-40 bottom-0 h-80 w-80 sm:h-[26rem] sm:w-[26rem]" aria-hidden="true"></div>

  <!-- Hand-drawn lightbulb doodle — "the toolkit" — gently swaying. -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute -right-6 top-28 hidden h-20 w-20 text-splash-yellow animate-wiggle sm:-right-8 sm:top-32 sm:block"
    viewBox="0 0 100 100"
    fill="none"
  >
    <circle cx="50" cy="40" r="26" stroke="currentColor" stroke-width="4" />
    <path d="M40 64 L60 64 L60 76 Q60 82 50 82 Q40 82 40 76 Z" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
    <path d="M44 76 L56 76" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    <path d="M50 8 L50 16 M18 40 L26 40 M74 40 L82 40" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>

  <span class="narration-caption reveal">The toolkit...</span>
  <div class="reveal mb-10 flex flex-wrap items-center gap-3">
    <p class="section-label">Skills &amp; Education</p>
    <span class="chapter-badge">CH. 03 / 06</span>
  </div>

  <div class="grid gap-14 sm:grid-cols-2">
    <div>
      <p class="mb-6 font-hand text-xl font-bold text-ink-900">Skills</p>
      <div class="space-y-6">
        {
          resume.skills.map((group) => (
            <div class="reveal">
              <h4 class="mb-2 font-hand text-xl font-bold text-ink-900">{group.category}</h4>
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="tag-pill">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div>
      <p class="mb-6 font-hand text-xl font-bold text-ink-900">Education</p>
      <div class="space-y-6">
        {
          resume.education.map((edu) => (
            <div class="panel panel-tape reveal p-5">
              <h4 class="text-lg text-ink-900 sm:text-xl">{edu.institution}</h4>
              <p class="mt-1 font-hand text-lg font-bold text-ink-700">{edu.degree}</p>
              <p class="mt-2 font-mono text-xs text-ink-400">
                {edu.startDate} — {edu.endDate} · {edu.location}
              </p>
              {edu.highlights?.length ? (
                <ul class="mt-3 space-y-1 text-base text-ink-700">
                  {edu.highlights.map((h) => (
                    <li class="flex gap-2">
                      <span class="bullet-star text-splash-blue">✦</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
