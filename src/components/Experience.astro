---
import { resume } from '@data/resume';
---

<section id="experience" class="mx-auto max-w-5xl px-6 py-16">
  <p class="section-label reveal mb-10">Experience</p>

  <div class="space-y-10">
    {
      resume.experience.map((job) => (
        <article class="panel reveal p-6 sm:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-xl text-ink-900 sm:text-2xl">
              {job.role} <span class="font-hand text-lg font-bold text-ink-700">· {job.company}</span>
            </h3>
            <span class="rounded-full border-2 border-ink-900 bg-paper-50 px-3 py-1 font-mono text-xs font-bold text-ink-700">
              {job.startDate} — {job.endDate}
            </span>
          </div>
          <p class="mt-1 font-mono text-xs text-ink-400">{job.location}</p>

          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-ink-700 sm:text-base">
            {job.highlights.map((point) => (
              <li class="flex gap-3">
                <span class="mt-1.5 text-splash-red">✦</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>

          {job.tags?.length ? (
            <div class="mt-5 flex flex-wrap gap-2">
              {job.tags.map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </div>
          ) : null}
        </article>
      ))
    }
  </div>
</section>
