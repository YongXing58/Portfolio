---
import '@/styles/global.css';
import { resume } from '@data/resume';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${resume.profile.name} — ${resume.profile.headline}`,
  description = resume.profile.summary,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Permanent Marker (display) + Caveat (hand accents)
         + Inter (body) + Space Mono (meta/dates/tags) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Caveat:wght@500;700&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Runs synchronously before body paints, so .reveal/.section-enter
      // elements never flash visible-then-hidden. See the CSS fallback
      // rule in global.css: without this class, they stay fully visible.
      document.documentElement.classList.add('js-reveal-ready');
    </script>
  </head>
  <body>
    <!-- Custom comic cursor mascot: a little star with a face, idle vs.
         "excited" (over links/buttons/panels) expressions. Only shown once
         JS confirms a fine pointer + no reduced-motion (see script below) —
         until then the browser's normal cursor stays exactly as-is. -->
    <div id="cursor-char" class="hidden" aria-hidden="true">
      <svg viewBox="0 0 100 100" width="40" height="40">
        <path
          d="M50 4 L61 38 L96 38 L68 59 L79 93 L50 72 L21 93 L32 59 L4 38 L39 38 Z"
          fill="#F6BE3B"
          stroke="#161311"
          stroke-width="4"
          stroke-linejoin="round"
        />
        <g class="face-idle">
          <circle cx="38" cy="50" r="3.5" fill="#161311" />
          <circle cx="62" cy="50" r="3.5" fill="#161311" />
          <path d="M38 62 Q50 70 62 62" fill="none" stroke="#161311" stroke-width="3.5" stroke-linecap="round" />
        </g>
        <g class="face-hover">
          <circle cx="38" cy="49" r="5" fill="#161311" />
          <circle cx="62" cy="49" r="5" fill="#161311" />
          <ellipse cx="50" cy="65" rx="8" ry="6" fill="#161311" />
        </g>
      </svg>
    </div>

    <slot />

    <script>
      // Scroll-reveal: fade/slide each .reveal element (inner panels) and
      // every .section-enter element (whole sections, a bigger sweep) in
      // as it enters the viewport, once each. Skips entirely if the
      // browser has no IntersectionObserver — CSS fallback keeps content
      // visible either way.
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );

        document.querySelectorAll('.reveal, .section-enter').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal, .section-enter').forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <script>
      // Mouse-reactive chrome: a trailing comic-mascot cursor, a subtle 3D
      // tilt on comic panels, and a little star-burst when a comic button
      // is clicked. All pure visual flourish — skipped entirely for touch
      // devices and for anyone who has asked for reduced motion, and the
      // real cursor is only hidden once this branch actually runs.
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (!prefersReducedMotion && hasFinePointer) {
        document.documentElement.classList.add('custom-cursor-active');

        // --- Trailing cursor mascot, lerped toward the real pointer each frame.
        const cursor = document.getElementById('cursor-char');
        if (cursor) {
          let targetX = window.innerWidth / 2;
          let targetY = window.innerHeight / 2;
          let x = targetX;
          let y = targetY;
          let revealed = false;

          window.addEventListener('mousemove', (e) => {
            targetX = e.clientX;
            targetY = e.clientY;
            if (!revealed) {
              cursor.classList.remove('hidden');
              revealed = true;
            }
          });

          // Excited face + slight grow over interactive elements.
          document.addEventListener('mouseover', (e) => {
            const target = e.target;
            if (target instanceof Element && target.closest('a, button, .panel')) {
              cursor.classList.add('is-hover');
            }
          });
          document.addEventListener('mouseout', (e) => {
            const target = e.target;
            if (target instanceof Element && target.closest('a, button, .panel')) {
              cursor.classList.remove('is-hover');
            }
          });
          window.addEventListener('mousedown', () => cursor.classList.add('is-active'));
          window.addEventListener('mouseup', () => cursor.classList.remove('is-active'));

          const tick = () => {
            x += (targetX - x) * 0.2;
            y += (targetY - y) * 0.2;
            cursor.style.left = `${x}px`;
            cursor.style.top = `${y}px`;
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }

        // --- Subtle tilt on comic panels, following the pointer within each.
        document.querySelectorAll<HTMLElement>('.panel').forEach((panel) => {
          panel.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = panel.getBoundingClientRect();
            const px = (e.clientX - rect.left) / rect.width - 0.5;
            const py = (e.clientY - rect.top) / rect.height - 0.5;
            panel.style.transform = `rotate(0deg) translate(-2px, -4px) scale(1.015) perspective(600px) rotateX(${py * -6}deg) rotateY(${px * 6}deg)`;
          });
          panel.addEventListener('mouseleave', () => {
            panel.style.transform = '';
          });
        });

        // --- Star-burst particles fired from a .comic-btn on click.
        const STAR_COUNT = 6;
        document.addEventListener('click', (e: MouseEvent) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          const btn = target.closest('.comic-btn');
          if (!btn) return;

          for (let i = 0; i < STAR_COUNT; i++) {
            const particle = document.createElement('span');
            particle.className = 'click-burst-particle';
            particle.textContent = i % 2 === 0 ? '★' : '✦';
            const angle = (Math.PI * 2 * i) / STAR_COUNT + Math.random() * 0.4;
            const distance = 36 + Math.random() * 24;
            particle.style.setProperty('--bx', `${Math.cos(angle) * distance}px`);
            particle.style.setProperty('--by', `${Math.sin(angle) * distance}px`);
            particle.style.setProperty('--br', `${(Math.random() - 0.5) * 180}deg`);
            particle.style.left = `${e.clientX}px`;
            particle.style.top = `${e.clientY}px`;
            particle.style.color = i % 3 === 0 ? '#F0483E' : i % 3 === 1 ? '#3A86C8' : '#F6BE3B';
            document.body.appendChild(particle);
            particle.addEventListener('animationend', () => particle.remove());
          }
        });
      }
    </script>
  </body>
</html>
