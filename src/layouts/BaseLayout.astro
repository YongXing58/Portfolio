---
import '@/styles/global.css';
import { resume } from '@data/resume';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${resume.profile.name} — ${resume.profile.headline}`,
  description = resume.profile.summary,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Permanent Marker (display headings) + Caveat (body
         AND hand accents — same family everywhere except headings/meta,
         per the user's "too many fonts" feedback) + Space Mono
         (meta/dates/tags). Full Caveat weight range loaded since body text
         now leans on weight, not a second typeface, to create hierarchy. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Caveat:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Runs synchronously before body paints, so .reveal/.section-enter
      // elements never flash visible-then-hidden. See the CSS fallback
      // rule in global.css: without this class, they stay fully visible.
      document.documentElement.classList.add('js-reveal-ready');
    </script>
  </head>
  <body>
    <!-- Custom comic cursor mascot: a little star with a face, idle vs.
         "excited" (over links/buttons/panels) expressions. Only shown once
         JS confirms a fine pointer + no reduced-motion (see script below) —
         until then the browser's normal cursor stays exactly as-is. -->
    <div id="cursor-char" class="hidden" aria-hidden="true">
      <svg viewBox="0 0 100 100" width="40" height="40">
        <path
          d="M50 4 L61 38 L96 38 L68 59 L79 93 L50 72 L21 93 L32 59 L4 38 L39 38 Z"
          fill="#F6BE3B"
          stroke="#161311"
          stroke-width="4"
          stroke-linejoin="round"
        />
        <g class="face-idle">
          <circle cx="38" cy="50" r="3.5" fill="#161311" />
          <circle cx="62" cy="50" r="3.5" fill="#161311" />
          <path d="M38 62 Q50 70 62 62" fill="none" stroke="#161311" stroke-width="3.5" stroke-linecap="round" />
        </g>
        <g class="face-hover">
          <circle cx="38" cy="49" r="5" fill="#161311" />
          <circle cx="62" cy="49" r="5" fill="#161311" />
          <ellipse cx="50" cy="65" rx="8" ry="6" fill="#161311" />
        </g>
      </svg>
    </div>

    <!-- A background diagonal ladder spanning the FULL WIDTH of the screen
         — bottom-left to top-right — with a stickman climbing up it and
         back down, endlessly. (Originally a narrow ladder tucked in the
         right margin; the user wanted it crossing the whole screen on a
         rising diagonal instead, like the running stickman but climbing
         a slope rather than staying level.)
         Rendered at every viewport size. Non-interference comes from
         paint order/z-index, not hiding: this div sits BEFORE the page's
         actual content in the DOM and has z-index:0, while `.panel`/other
         content has no z-index of its own (auto) — per CSS stacking
         rules, same-"level" elements paint in DOM order, so the
         later-in-DOM real content paints on top of this wherever they'd
         overlap. The ladder only shows through in open background space,
         never over text/panels.
         The climbing figure is a child of the SAME <svg> as the ladder
         rails and animated with native SMIL (<animateTransform>) rather
         than a separately-CSS-animated sibling element — guarantees it
         tracks the exact diagonal the rails are drawn on. Alternating
         arm/leg pose groups (reusing the running stickman's stride-a/b
         opacity-toggle keyframes) give it a real climbing gait. Hidden
         under prefers-reduced-motion, same as the other mascots. -->
    <div id="ladder-climb" aria-hidden="true">
      <svg viewBox="0 0 1000 600" preserveAspectRatio="none" width="100%" height="100%">
        <!-- Rails: bottom-left to top-right, full width -->
        <line x1="40" y1="560" x2="920" y2="40" stroke="#161311" stroke-width="5" stroke-linecap="round" opacity="0.22" />
        <line x1="100" y1="560" x2="980" y2="40" stroke="#161311" stroke-width="5" stroke-linecap="round" opacity="0.22" />
        <!-- Rungs, evenly spaced along the diagonal -->
        <line x1="110" y1="518" x2="170" y2="518" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="207" y1="461" x2="267" y2="461" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="304" y1="404" x2="364" y2="404" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="401" y1="347" x2="461" y2="347" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="498" y1="290" x2="558" y2="290" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="594" y1="232" x2="654" y2="232" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="691" y1="175" x2="751" y2="175" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="788" y1="118" x2="848" y2="118" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <line x1="885" y1="61" x2="945" y2="61" stroke="#161311" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <!-- Climbing stickman — travels bottom-left of the ladder to
             top-right and back, tracking the rails' exact diagonal since
             it shares this viewBox's coordinate space. -->
        <g>
          <animateTransform
            attributeName="transform"
            type="translate"
            values="70,555; 950,45; 70,555"
            keyTimes="0; 0.5; 1"
            calcMode="spline"
            keySplines="0.42 0 0.58 1; 0.42 0 0.58 1"
            dur="18s"
            repeatCount="indefinite"
          />
          <g class="climb-frame-a">
            <circle cx="0" cy="-10" r="9" fill="none" stroke="#161311" stroke-width="5" />
            <path d="M0 -1 L0 22" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 3 L18 -16" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 3 L-15 13" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 22 L13 37" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 22 L-13 44" stroke="#161311" stroke-width="5" stroke-linecap="round" />
          </g>
          <g class="climb-frame-b">
            <circle cx="0" cy="-10" r="9" fill="none" stroke="#161311" stroke-width="5" />
            <path d="M0 -1 L0 22" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 3 L15 13" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 3 L-18 -16" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 22 L13 44" stroke="#161311" stroke-width="5" stroke-linecap="round" />
            <path d="M0 22 L-13 37" stroke="#161311" stroke-width="5" stroke-linecap="round" />
          </g>
        </g>
      </svg>
    </div>

    <!-- A little stickman that jogs across the screen every so often — pure
         CSS animation (no JS dependency, works even with scripts off).
         Two alternating leg/arm poses give it an actual running motion
         rather than just sliding. Fixed position, so it runs over whatever
         section is currently in view. Hidden entirely under
         prefers-reduced-motion (see global.css) rather than freezing
         mid-stride. -->
    <div id="running-stickman" aria-hidden="true">
      <svg viewBox="0 0 60 60" width="48" height="48">
        <circle cx="42" cy="12" r="7" fill="none" stroke="#161311" stroke-width="4" />
        <g class="stride-frame frame-a">
          <path d="M38 18 L24 34" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M32 22 L44 14" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M32 22 L20 30" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M24 34 L36 50" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M24 34 L10 44" stroke="#161311" stroke-width="4" stroke-linecap="round" />
        </g>
        <g class="stride-frame frame-b">
          <path d="M38 18 L24 34" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M32 22 L44 30" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M32 22 L20 14" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M24 34 L36 44" stroke="#161311" stroke-width="4" stroke-linecap="round" />
          <path d="M24 34 L10 50" stroke="#161311" stroke-width="4" stroke-linecap="round" />
        </g>
      </svg>
    </div>

    <slot />

    <script>
      // Scroll-reveal: fade/slide each .reveal element (inner panels) and
      // every .section-enter element (whole sections, a bigger sweep) in
      // as it enters the viewport, once each. Skips entirely if the
      // browser has no IntersectionObserver — CSS fallback keeps content
      // visible either way.
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );

        document.querySelectorAll('.reveal, .section-enter').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal, .section-enter').forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <script>
      // Scroll-progress dots in the header: mark whichever top-level
      // section/footer is currently most visible as `.is-active` on the
      // matching `.progress-dot[data-target]`. Independent of the mouse-
      // effects gate below — this is plain scroll tracking, useful on
      // touch too, not a mouse-only flourish.
      if ('IntersectionObserver' in window) {
        const dots = document.querySelectorAll<HTMLElement>('.progress-dot');
        if (dots.length) {
          const dotObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                const id = entry.target.id;
                const dot = document.querySelector(`.progress-dot[data-target="${id}"]`);
                if (dot && entry.isIntersecting) {
                  dots.forEach((d) => d.classList.remove('is-active'));
                  dot.classList.add('is-active');
                }
              }
            },
            { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
          );
          document.querySelectorAll('.snap-section, footer[id]').forEach((el) => dotObserver.observe(el));
        }
      }
    </script>

    <script>
      // Mouse-reactive chrome: a trailing comic-mascot cursor, a subtle 3D
      // tilt on comic panels, and a little star-burst when a comic button
      // is clicked. All pure visual flourish — skipped entirely for touch
      // devices and for anyone who has asked for reduced motion, and the
      // real cursor is only hidden once this branch actually runs.
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (!prefersReducedMotion && hasFinePointer) {
        document.documentElement.classList.add('custom-cursor-active');

        // --- Trailing cursor mascot, lerped toward the real pointer each frame.
        const cursor = document.getElementById('cursor-char');
        if (cursor) {
          let targetX = window.innerWidth / 2;
          let targetY = window.innerHeight / 2;
          let x = targetX;
          let y = targetY;
          let revealed = false;

          window.addEventListener('mousemove', (e) => {
            targetX = e.clientX;
            targetY = e.clientY;
            if (!revealed) {
              cursor.classList.remove('hidden');
              revealed = true;
            }
          });

          // Excited face + slight grow over interactive elements.
          document.addEventListener('mouseover', (e) => {
            const target = e.target;
            if (target instanceof Element && target.closest('a, button, .panel')) {
              cursor.classList.add('is-hover');
            }
          });
          document.addEventListener('mouseout', (e) => {
            const target = e.target;
            if (target instanceof Element && target.closest('a, button, .panel')) {
              cursor.classList.remove('is-hover');
            }
          });
          window.addEventListener('mousedown', () => cursor.classList.add('is-active'));
          window.addEventListener('mouseup', () => cursor.classList.remove('is-active'));

          const tick = () => {
            x += (targetX - x) * 0.2;
            y += (targetY - y) * 0.2;
            cursor.style.left = `${x}px`;
            cursor.style.top = `${y}px`;
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }

        // --- Subtle tilt on comic panels, following the pointer within each.
        document.querySelectorAll<HTMLElement>('.panel').forEach((panel) => {
          panel.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = panel.getBoundingClientRect();
            const px = (e.clientX - rect.left) / rect.width - 0.5;
            const py = (e.clientY - rect.top) / rect.height - 0.5;
            panel.style.transform = `rotate(0deg) translate(-2px, -4px) scale(1.015) perspective(600px) rotateX(${py * -6}deg) rotateY(${px * 6}deg)`;
          });
          panel.addEventListener('mouseleave', () => {
            panel.style.transform = '';
          });
        });

        // --- Star-burst particles fired from a .comic-btn on click.
        const STAR_COUNT = 6;
        document.addEventListener('click', (e: MouseEvent) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          const btn = target.closest('.comic-btn');
          if (!btn) return;

          for (let i = 0; i < STAR_COUNT; i++) {
            const particle = document.createElement('span');
            particle.className = 'click-burst-particle';
            particle.textContent = i % 2 === 0 ? '★' : '✦';
            const angle = (Math.PI * 2 * i) / STAR_COUNT + Math.random() * 0.4;
            const distance = 36 + Math.random() * 24;
            particle.style.setProperty('--bx', `${Math.cos(angle) * distance}px`);
            particle.style.setProperty('--by', `${Math.sin(angle) * distance}px`);
            particle.style.setProperty('--br', `${(Math.random() - 0.5) * 180}deg`);
            particle.style.left = `${e.clientX}px`;
            particle.style.top = `${e.clientY}px`;
            particle.style.color = i % 3 === 0 ? '#F0483E' : i % 3 === 1 ? '#3A86C8' : '#F6BE3B';
            document.body.appendChild(particle);
            particle.addEventListener('animationend', () => particle.remove());
          }
        });
      }
    </script>
  </body>
</html>
