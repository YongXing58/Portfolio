---
import '@/styles/global.css';
import { resume } from '@data/resume';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${resume.profile.name} — ${resume.profile.headline}`,
  description = resume.profile.summary,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Permanent Marker (display) + Caveat (hand accents)
         + Inter (body) + Space Mono (meta/dates/tags) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Caveat:wght@500;700&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Runs synchronously before body paints, so .reveal elements never
      // flash visible-then-hidden. See the CSS fallback rule in
      // global.css: without this class, .reveal stays fully visible.
      document.documentElement.classList.add('js-reveal-ready');
    </script>
  </head>
  <body>
    <div id="cursor-dot"></div>
    <slot />

    <script>
      // Scroll-reveal: fade/slide each .reveal element in as it enters the
      // viewport, once. Skips entirely if the browser has no
      // IntersectionObserver — CSS fallback already keeps content visible.
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );

        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <script>
      // Mouse-reactive chrome: a trailing cursor dot + a subtle 3D tilt on
      // comic panels as the pointer moves over them. Both are pure visual
      // flourish, so they're skipped entirely for touch devices and for
      // anyone who has asked for reduced motion.
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (!prefersReducedMotion && hasFinePointer) {
        // --- Trailing cursor dot, lerped toward the real pointer each frame.
        const dot = document.getElementById('cursor-dot');
        if (dot) {
          let targetX = window.innerWidth / 2;
          let targetY = window.innerHeight / 2;
          let x = targetX;
          let y = targetY;
          let revealed = false;

          window.addEventListener('mousemove', (e) => {
            targetX = e.clientX;
            targetY = e.clientY;
            if (!revealed) {
              dot.classList.remove('hidden');
              revealed = true;
            }
          });

          // Grow the dot over interactive elements to hint clickability.
          document.addEventListener('mouseover', (e) => {
            const target = e.target;
            if (target instanceof Element && target.closest('a, button, .panel')) {
              dot.style.width = '2.25rem';
              dot.style.height = '2.25rem';
              dot.style.backgroundColor = 'rgba(246, 190, 59, 0.5)';
            }
          });
          document.addEventListener('mouseout', (e) => {
            const target = e.target;
            if (target instanceof Element && target.closest('a, button, .panel')) {
              dot.style.width = '';
              dot.style.height = '';
              dot.style.backgroundColor = '';
            }
          });

          const tick = () => {
            x += (targetX - x) * 0.18;
            y += (targetY - y) * 0.18;
            dot.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }

        // --- Subtle tilt on comic panels, following the pointer within each.
        document.querySelectorAll<HTMLElement>('.panel').forEach((panel) => {
          panel.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = panel.getBoundingClientRect();
            const px = (e.clientX - rect.left) / rect.width - 0.5;
            const py = (e.clientY - rect.top) / rect.height - 0.5;
            panel.style.transform = `rotate(0deg) translate(-2px, -4px) perspective(600px) rotateX(${py * -6}deg) rotateY(${px * 6}deg)`;
          });
          panel.addEventListener('mouseleave', () => {
            panel.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
