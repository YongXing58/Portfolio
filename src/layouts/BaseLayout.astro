---
import '@/styles/global.css';
import { resume } from '@data/resume';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${resume.profile.name} — ${resume.profile.headline}`,
  description = resume.profile.summary,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Space Grotesk (headings) + IBM Plex Sans/Mono (body/labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Runs synchronously before body paints, so .reveal elements never
      // flash visible-then-hidden. See the CSS fallback rule in
      // global.css: without this class, .reveal stays fully visible.
      document.documentElement.classList.add('js-reveal-ready');
    </script>
  </head>
  <body>
    <slot />

    <script>
      // Scroll-reveal: fade/slide each .reveal element in as it enters the
      // viewport, once. Skips entirely if the browser has no
      // IntersectionObserver — CSS fallback already keeps content visible.
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );

        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
